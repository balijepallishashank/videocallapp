# Copy this file to .env.local after creating the external services.
# Never commit real secrets.

# App
VITE_APP_NAME="Video Call App"
VITE_PUBLIC_APP_URL="http://localhost:5173"

# Backend API created for this app
VITE_API_BASE_URL="http://localhost:4000"
VITE_REALTIME_URL="ws://localhost:4000"

# Auth/session - server only
JWT_SECRET="replace-with-long-random-secret"
SESSION_SECRET="replace-with-long-random-secret"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Video rooms - choose one provider
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"

# Real-time speech-to-text - choose one provider
DEEPGRAM_API_KEY="replace-with-deepgram-api-key"
ASSEMBLYAI_API_KEY="replace-with-assemblyai-api-key"
OPENAI_API_KEY="replace-with-openai-api-key"
GOOGLE_APPLICATION_CREDENTIALS="absolute-path-to-google-service-account-json"

# File/recording storage - choose one provider
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="video-call-recordings"
S3_ACCESS_KEY_ID="replace-with-storage-access-key"
S3_SECRET_ACCESS_KEY="replace-with-storage-secret-key"
S3_PUBLIC_BASE_URL="https://cdn.example.com"

# Email/notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-user"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="no-reply@example.com"
