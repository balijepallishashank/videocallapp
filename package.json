{
  "name": "video-call-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "npm run test:e2e",
    "test:e2e": "npx playwright test",
    "test:a11y": "npx playwright test --project=chromium --grep @a11y",
    "audit:lights": "npx lighthouse http://localhost:5173 --output=json --output-path=reports/lighthouse.json --chrome-flags=\"--headless\"",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.378.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lighthouse": "^13.3.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^5.0.8"
  }
}
