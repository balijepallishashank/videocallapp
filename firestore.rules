rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isFaculty() {
      // Assumes we store role on the user document
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Anyone authenticated can read user profiles
      allow write: if request.auth.uid == userId; // Users can only update their own profile
    }

    // Academic Structure Collection
    match /academic_structure/{deptId} {
      allow read: if isAuthenticated(); // Students and Faculty can read
      allow write: if isFaculty(); // Only faculty can update the academic structure
    }

    // Meetings Collection
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isFaculty(); // Only faculty can create/update meetings
    }

    // Requests (Doubt requests, notifications)
    match /requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.requestedBy == request.auth.uid || isFaculty());
      allow create: if isAuthenticated();
      allow update, delete: if isFaculty() || resource.data.requestedBy == request.auth.uid;
    }
  }
}
